{
  "name": "game-power",
  "version": "0.3.0",
  "description": "Many instances of a web game on screen at once, tiled, with live RAM per instance — the multi-instance grid an Android emulator gives you, without the Android.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "RCA Power",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rca.gamepower",
    "productName": "Game Power",
    "asar": false,
    "files": [
      "**/*",
      "!dist${/*}"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "directories": {
      "output": "dist"
    }
  }
}
